    <string name="trakt_client_secret">Client Secret</string>
    <string name="trakt_continue">தொடர்</string>
    <string name="trakt_code_title">DebForge-ஐ அனுமதி</string>
    <string name="trakt_code_body">%1$s-க்குச் சென்று இந்தக் குறியீட்டை உள்ளிடவும்:</string>
