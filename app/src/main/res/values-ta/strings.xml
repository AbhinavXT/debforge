    <string name="trakt_title">Trakt</string>
    <string name="trakt_detail">DebForge பிளேயரில் பார்ப்பதை Trakt-இல் குறிக்கவும், வேறு இடத்தில் பார்த்தவற்றை ✓ பார்த்தது எனக் காட்டவும்.</string>
    <string name="trakt_connect">இணை</string>
    <string name="trakt_setup_title">Trakt-ஐ இணை</string>
    <string name="trakt_setup_body">Trakt-க்கு உங்கள் சொந்த ஆப் தேவை (இலவசம், ஒரு நிமிடம் ஆகும்). Trakt-இல் ஏதேனும் பெயருடனும் ரீடைரக்ட் URI ஆக %1$s உடனும் புதிய அப்ளிகேஷனை உருவாக்கி, அதன் Client ID மற்றும் Client Secret-ஐ இங்கே ஒட்டவும்.</string>
    <string name="trakt_open_new_app">Trakt-இல் ஆப்பை உருவாக்கு</string>
