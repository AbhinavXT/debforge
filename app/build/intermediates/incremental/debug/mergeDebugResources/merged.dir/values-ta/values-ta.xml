    <string name="notif_channel_desc">செயலில் உள்ள பதிவிறக்கங்களின் முன்னேற்றம்</string>
    <string name="notif_downloaded">பதிவிறக்கப்பட்டது</string>
    <string name="notif_follow_body">பதிவிறக்க வரிசையில் உள்ளது. தொடங்கவில்லை என்றால் DebForge-ஐத் திறக்கவும்.</string>
    <string name="notif_follow_one">புதிய எபிசோட்: %1$s</string>
    <string name="notif_paused_body">Android-இன் பின்னணி நேர வரம்பு எட்டப்பட்டது. தொடர தட்டவும்.</string>
    <string name="notif_paused_title">பதிவிறக்கங்கள் இடைநிறுத்தப்பட்டன</string>
    <string name="notif_preparing">பதிவிறக்கம் தயாராகிறது</string>
    <string name="notif_ready_body">பதிவிறக்க வரிசையில் உள்ளது. தொடங்க தட்டவும்.</string>
    <string name="notif_ready_one">தயார்: %1$s</string>
    <string name="notif_sched_body">தொடங்க தட்டவும். தானாகத் தொடங்க \"அலாரங்கள் &amp; நினைவூட்டல்கள்\" அனுமதியை வழங்கவும்.</string>
    <string name="notif_sched_title">திட்டமிட்ட பதிவிறக்கங்கள் தொடங்கத் தயார்</string>
    <string name="notif_waiting_resume">%1$s — தானாகத் தொடரும்</string>
    <string name="player_error_body">இயக்கம் நின்றது (%1$s). வேறு வீடியோ பிளேயர் இதை இயக்கக்கூடும்.</string>
    <string name="player_keep_watching">தொடர்ந்து பார்</string>
    <string name="player_network_body">இணைப்பு துண்டிக்கப்பட்டது அல்லது இணைப்பின் காலம் முடிந்தது. மீண்டும் முயலவும் அல்லது இணைப்பைச் சரிபார்க்கவும்.</string>
    <string name="player_network_title">வீடியோவை ஏற்ற முடியவில்லை</string>
    <string name="player_next">அடுத்து: %1$s</string>
    <string name="player_next_failed">அடுத்த எபிசோடை ஏற்ற முடியவில்லை.</string>
    <string name="player_no_audio_body">இந்த வீடியோவின் ஆடியோ வடிவம் இந்தச் சாதனத்தில் ஆதரிக்கப்படவில்லை, எனவே ஒலியின்றி இயங்கும். VLC அல்லது வேறு பிளேயர் ஆடியோவை இயக்கும்.</string>
    <string name="player_play_now">இப்போது இயக்கு</string>
    <string name="player_start_over">↺ தொடக்கத்திலிருந்து</string>
    <string name="player_unsupported_body">இந்தச் சாதனம் DebForge பிளேயரில் இந்த வீடியோவை டிகோட் செய்ய முடியாது. VLC அல்லது வேறு பிளேயர் பொதுவாக இயக்கும்.</string>
    <string name="player_unsupported_title">இங்கே இயக்க முடியாது</string>
    <string name="poster_banner">போஸ்டர்களும் விளக்கங்களும் காண இலவச TMDB key-ஐச் சேர்க்கவும்</string>
    <string name="poster_banner_action">அமை</string>
    <string name="poster_downloaded">✓ பதிவிறக்கப்பட்டது</string>
    <string name="poster_file_tag">கோப்பு</string>
    <string name="poster_movie_tag">திரைப்படம்</string>
    <string name="poster_series_tag">தொடர்</string>
    <string name="poster_setup_bad_format">இது TMDB key போலத் தெரியவில்லை. API Read Access Token அல்லது 32 எழுத்து API key-ஐ நகலெடுக்கவும்.</string>
    <string name="poster_setup_body">DebForge போஸ்டர்களையும் விளக்கங்களையும் TMDB-யிலிருந்து பெறுகிறது — இது திரைப்படம், டிவி தொடர்களுக்கான இலவச தரவுத்தளம். இதற்கு உங்கள் சொந்த இலவச key தேவை, சுமார் இரண்டு நிமிடங்கள் ஆகும்:</string>
    <string name="poster_setup_check">சரிபார்த்துச் சேமி</string>
    <string name="poster_setup_done">போஸ்டர்கள் இயக்கப்பட்டன</string>
    <string name="poster_setup_open">TMDB-ஐத் திற</string>
    <string name="poster_setup_paste">ஒட்டு</string>
    <string name="poster_setup_rejected">TMDB இந்த key-ஐ ஏற்கவில்லை. முழுவதையும் நகலெடுத்தீர்களா எனப் பார்க்கவும்.</string>
    <string name="poster_setup_save_anyway">இருந்தாலும் சேமி</string>
    <string name="poster_setup_step1">TMDB-ஐத் திறந்து உள்நுழையவும், அல்லது இலவச கணக்கை உருவாக்கவும்.</string>
    <string name="poster_setup_step2">API பகுதியில் தனிப்பட்ட பயன்பாட்டுக்கான key-ஐக் கோரவும்.</string>
    <string name="poster_setup_step3">“API Read Access Token”-ஐ (அல்லது API key-ஐ) நகலெடுத்து கீழே ஒட்டவும்.</string>
    <string name="poster_setup_title">போஸ்டர்களை இயக்கு</string>
    <string name="poster_setup_unreachable">key-ஐச் சரிபார்க்க TMDB-ஐ அணுக முடியவில்லை.</string>
    <string name="processing_auto_when_ready">தயாரானதும் தானாகப் பதிவிறக்கம்</string>
    <string name="processing_on">%1$s-இல் செயலாக்கப்படுகிறது</string>
    <string name="processing_will_auto">தானாகப் பதிவிறக்கப்படும்</string>
    <string msgid="5941395253238309765" name="range_end">"வரம்பு முடிவு"</string>
    <string msgid="7097486360902471446" name="range_start">"வரம்பு தொடக்கம்"</string>
    <string name="remove_body">“%1$s” உங்கள் %2$s கணக்கிலிருந்து நீக்கப்படும். இந்த ஃபோனில் ஏற்கெனவே சேமிக்கப்பட்ட கோப்புகள் அப்படியே இருக்கும். இதன் முடிக்கப்படாத பதிவிறக்கங்கள் ரத்துசெய்யப்படும்.</string>
    <string name="remove_title">%1$s-இலிருந்து அகற்றவா?</string>
    <string name="restore_failed">மீட்டெடுக்க முடியவில்லை: %1$s</string>
    <string name="restore_folder_skipped">பதிவிறக்கக் கோப்புறை மீட்டெடுக்கப்படவில்லை: வேறொரு ஃபோனில் தேர்ந்தெடுத்த கோப்புறையை இங்கே பயன்படுத்த முடியாது. அமைப்புகளில் மீண்டும் தேர்ந்தெடுக்கவும்.</string>
    <string name="restore_needs_password">இந்தக் காப்புப்பிரதியில் உள்நுழைவுகள் உள்ளன. அவற்றை மீட்டெடுக்க அதன் கடவுச்சொல்லை உள்ளிடவும், அல்லது அமைப்புகளை மட்டும் மீட்டெடுக்கவும்.</string>
