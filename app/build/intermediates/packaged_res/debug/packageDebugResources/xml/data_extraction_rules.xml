<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup rules. API tokens must not leave the device: they'd be
   copied to Google Drive and silently restored onto other phones. Settings
   (download folder, theme, sort) are fine to back up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/debforge_token.preferences_pb" />
        <exclude domain="database" path="debforge.db" />
        <exclude domain="file" path="crash/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/debforge_token.preferences_pb" />
        <exclude domain="file" path="crash/" />
    </device-transfer>
</data-extraction-rules>
