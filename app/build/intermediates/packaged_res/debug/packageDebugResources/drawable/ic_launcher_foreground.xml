<?xml version="1.0" encoding="utf-8"?>
<!-- "Forge" mark: a white-hot download arrow striking an anvil, throwing
     sparks. Everything sits inside the 66dp adaptive-icon safe circle
     (centre 54,54), so no launcher mask clips it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft ground shadow: a radial circle squashed vertically. -->
    <group android:pivotX="54" android:pivotY="80" android:scaleY="0.18">
        <path android:pathData="M32,80a22,22 0,1 0,44 0a22,22 0,1 0,-44 0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="54"
                    android:centerY="80"
                    android:gradientRadius="22">
                    <item android:offset="0" android:color="#59000000" />
                    <item android:offset="1" android:color="#00000000" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Heat glow around the point of impact. -->
    <path android:pathData="M34,58a20,20 0,1 0,40 0a20,20 0,1 0,-40 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="58"
                android:gradientRadius="20">
                <item android:offset="0" android:color="#E6FEF3C7" />
                <item android:offset="0.5" android:color="#59FCD34D" />
                <item android:offset="1" android:color="#00FCD34D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Anvil: tapered horn (left), heel, waist, footed base. -->
    <path android:pathData="M25,59.2C31,57.6 36,57.2 41,57.2L74.5,57.2Q76.5,57.2 76.5,59.2L76.5,61.8Q76.5,63.6 74.5,63.6L66.5,63.6C63.6,64.6 62.4,66.6 62.4,69.6L62.4,72.4L67.8,72.4Q70,72.4 70.8,74.4L72.4,78.4L35.6,78.4L37.2,74.4Q38,72.4 40.2,72.4L45.6,72.4L45.6,69.6C45.6,66.4 44,64.4 40.6,63.6C35.5,63.3 30.5,62 25,59.2Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="58"
                android:endX="54"
                android:endY="79">
                <item android:offset="0" android:color="#FF3F3A36" />
                <item android:offset="1" android:color="#FF171412" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Bevel highlight on the anvil's face. -->
    <path
        android:fillColor="#FF8A817A"
        android:pathData="M41,57.2L74.5,57.2Q76.5,57.2 76.5,59.2L76.5,59.6L41,59.6C35.5,59.6 30.5,60 26.6,60C31.5,57.6 36,57.2 41,57.2Z" />
    <!-- Impact flash. -->
    <path
        android:fillColor="#FFFFFBEB"
        android:pathData="M47,57.4a7,1.4 0,1 0,14 0a7,1.4 0,1 0,-14 0z" />

    <!-- The arrow: white-hot at the top, cooling to amber at the tip. -->
    <path android:pathData="M49,30Q49,26 54,26Q59,26 59,30L59,41L65.6,41Q68.2,41 66.6,43.1L55.7,54.3Q54,56 52.3,54.3L41.4,43.1Q39.8,41 42.4,41L49,41Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="26"
                android:endX="54"
                android:endY="54">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.55" android:color="#FFFFF4D1" />
                <item android:offset="1" android:color="#FFFDBA4A" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Thin rim so the tip stays distinct from the glow at small sizes. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFC2410C"
        android:strokeAlpha="0.55"
        android:strokeWidth="0.8"
        android:pathData="M49,30Q49,26 54,26Q59,26 59,30L59,41L65.6,41Q68.2,41 66.6,43.1L55.7,54.3Q54,56 52.3,54.3L41.4,43.1Q39.8,41 42.4,41L49,41Z" />

    <!-- Sparks. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFF7D6"
        android:strokeLineCap="round"
        android:strokeWidth="2.2"
        android:pathData="M44.5,53L38,48.5M63.5,53L70,48.5" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFF7D6"
        android:strokeLineCap="round"
        android:strokeWidth="1.8"
        android:pathData="M42,56.4L34.5,55.6M66,56.4L73.5,55.6" />
    <path
        android:fillColor="#FFFFF7D6"
        android:pathData="M34.2,45a1.3,1.3 0,1 0,2.6 0a1.3,1.3 0,1 0,-2.6 0zM71.9,44.2a1.1,1.1 0,1 0,2.2 0a1.1,1.1 0,1 0,-2.2 0z" />
    <path
        android:fillColor="#FFFDE68A"
        android:pathData="M30.1,51.5a0.9,0.9 0,1 0,1.8 0a0.9,0.9 0,1 0,-1.8 0zM76.7,51a0.8,0.8 0,1 0,1.6 0a0.8,0.8 0,1 0,-1.6 0z" />
</vector>
